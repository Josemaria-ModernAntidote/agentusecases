---
import Analytics from "../components/Analytics.astro";
import data from '../data/usecases.json';
const cats = [...new Set(data.map(d => d.category))];
const agents = [...new Set(data.flatMap(d => d.tools))];
const title = 'AI Agent Use Cases: Real things people do with AI agents';
const desc = `A searchable directory of ${data.length} real AI agent use cases across ${cats.length} categories and ${agents.length} agents, with tools and source links.`;
const url = 'https://agent-uses.com/';
const slugify = (s) => s.toLowerCase().replace(/&/g,'and').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
const ogImage = 'https://agent-uses.com/og.png';
const ld = [
  { '@context':'https://schema.org','@type':'WebSite', name: 'AI Agent Use Cases', url: Astro.site ? new URL('/', Astro.site).href : 'https://agent-uses.com/', description: desc, potentialAction: { '@type':'SearchAction', target: { '@type':'EntryPoint', urlTemplate: (Astro.site ? new URL('/', Astro.site).href : 'https://agent-uses.com/') + '?q={search_term_string}' }, 'query-input':'required name=search_term_string' } },
  { '@context':'https://schema.org','@type':'Organization', name: 'AI Agent Use Cases', url: Astro.site ? new URL('/', Astro.site).href : 'https://agent-uses.com/', logo: ogImage },
  { '@context':'https://schema.org','@type':'ItemList', name: title, itemListElement: data.map((d,i)=>({'@type':'ListItem',position:i+1,name:d.title,url:'https://agent-uses.com/use-cases/'+d.slug+'/'})) }
];
---
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title><meta name="description" content={desc}><link rel="canonical" href={url}>
<meta property="og:type" content="website"><meta property="og:title" content={title}><meta property="og:description" content={desc}><meta property="og:url" content={url}><meta property="og:image" content={ogImage}><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content={title}><meta name="twitter:description" content={desc}><meta name="twitter:image" content={ogImage}>
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt"><link rel="alternate" type="application/rss+xml" href="/rss.xml" title="AI Agent Use Cases: new use cases">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<style is:global>
:root{--bg:#0b0d12;--card:#141823;--line:#232a3a;--fg:#e8ecf4;--mut:#94a0b8;--acc:#7c5cff}
*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,sans-serif;background:var(--bg);color:var(--fg)}
a{color:inherit}.wrap{max-width:1120px;margin:0 auto;padding:0 20px}
header{padding:32px 0 8px}h1{font-size:clamp(28px,5vw,44px);margin:0 0 6px;letter-spacing:-.02em}
h1 span{background:linear-gradient(90deg,#7c5cff,#2ad4ff);-webkit-background-clip:text;color:transparent}
.sub{color:var(--mut);font-size:16px;max-width:640px;margin:0}
.sponsor{display:flex;justify-content:space-between;align-items:center;gap:12px;border:1px dashed var(--acc);border-radius:14px;padding:14px 18px;margin:20px 0;color:var(--mut)}
.btn{background:var(--acc);color:#fff;border:0;border-radius:10px;padding:10px 16px;font-weight:600;text-decoration:none;cursor:pointer}
.controls{position:sticky;top:0;background:var(--bg);padding:14px 0;z-index:2}
input[type=search],input[type=email]{width:100%;padding:12px 14px;border-radius:10px;border:1px solid var(--line);background:var(--card);color:var(--fg);font-size:16px}
.frow{display:flex;gap:10px;align-items:center;margin-top:10px}.chips{display:flex;flex-wrap:nowrap;overflow-x:auto;gap:6px;flex:1;min-width:0;scrollbar-width:none;-webkit-mask-image:linear-gradient(90deg,#000 92%,transparent)}.chips::-webkit-scrollbar{display:none}select{background:var(--card);color:var(--fg);border:1px solid var(--line);border-radius:10px;padding:8px 10px;font-size:14px;max-width:44%}.foot{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}.vote{font-size:12px;color:var(--mut)}.vote button{background:none;border:1px solid var(--line);border-radius:8px;margin-left:4px;cursor:pointer;padding:2px 6px}.vote.done button{opacity:.4}.vote button.on{opacity:1;border-color:var(--acc)}@media(max-width:600px){.frow{flex-direction:column;align-items:stretch}select{max-width:none}}.chip{border:1px solid var(--line);background:var(--card);color:var(--mut);border-radius:999px;padding:5px 11px;cursor:pointer;white-space:nowrap;font-size:13px}
.chip.on{background:var(--acc);color:#fff;border-color:var(--acc)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;margin:10px 0 40px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;display:flex;flex-direction:column;gap:8px}
.card h3{margin:0;font-size:17px}.card p{margin:0;color:var(--mut);font-size:14px;line-height:1.5;flex:1}
.meta{display:flex;flex-wrap:wrap;gap:6px;font-size:12px}.tag{background:#1d2333;border-radius:6px;padding:3px 8px}.cat{color:#2ad4ff}.niche{color:#ffb86b;background:#2a2116}
.src{font-size:13px;color:#a99bff}section h2{font-size:28px;margin:48px 0 16px}
.plans{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}.plan{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:22px}
.price{font-size:30px;font-weight:700;margin:6px 0}.news{display:flex;gap:10px;max-width:520px}footer{color:var(--mut);padding:40px 0;font-size:14px;border-top:1px solid var(--line);margin-top:48px}
</style><Analytics /></head><body><div class="wrap">
<header><h1>AI <span>Agent Use Cases</span></h1><p class="sub">{data.length} real workflows people run with AI agents, each with a source.</p><p class="sub" style="font-size:14px">Browse by <a href="/agents/">agent</a> · <a href="/categories/">category</a> · <a href="/niche/">niche &amp; surprising</a> · <a href="/about/">About &amp; FAQ</a></p></header>
<div class="controls"><input id="q" type="search" placeholder={`Search ${data.length} use cases…`} aria-label="Search">
<div class="frow"><div class="chips" role="group" aria-label="Category"><button class="chip on" data-cat="">All</button>{cats.map(c=> <button class="chip" data-cat={c}>{c}</button>)}</div>
<select id="agent" aria-label="Filter by agent"><option value="">All agents</option>{agents.map(a=> <option value={a}>{a} ({data.filter(d=>d.tools.includes(a)).length})</option>)}</select></div></div>
<p id="count" style="color:var(--mut)"></p>
<div class="grid" id="grid">{data.map(d=> <article class="card" data-slug={d.slug} data-cat={d.category} data-agents={d.tools.join('|')} data-niche={d.niche ? '1' : undefined} data-text={(d.title+' '+d.description+' '+d.tools.join(' ')+' '+d.category+(d.niche?' niche':'')).toLowerCase()}>
<div class="meta"><a class="cat" style="text-decoration:none" href={`/categories/${slugify(d.category)}/`}>{d.category}</a>{d.niche && <span class="tag niche" title="Niche, surprising use case">Niche</span>}</div><h3><a href={`/use-cases/${d.slug}/`} style="text-decoration:none">{d.title}</a></h3><p>{d.description}</p>
<div class="meta">{d.tools.map(t=> <a class="tag" style="text-decoration:none" href={`/agents/${slugify(t)}/`}>{t}</a>)}</div>
<div class="foot"><a class="src" href={d.source} target="_blank" rel="noopener" data-slug={d.slug} data-agent={d.tools.join(',')}>Source: {d.sourceName} ↗</a><span class="vote" data-slug={d.slug}>Useful? <button data-v="up" aria-label="Useful">👍</button><button data-v="down" aria-label="Not useful">👎</button></span></div></article>)}</div>
<section id="pricing"><h2>Get featured</h2><div class="plans">
<div class="plan"><b>Free listing</b><div class="price">$0</div><p class="sub" style="font-size:14px">Submit a real use case with a public source link.</p><a class="btn" href="mailto:josemaria@mail.grokbot.com">Submit</a></div>
<div class="plan"><b>Featured listing</b><div class="price">TBD</div><p class="sub" style="font-size:14px">Pinned at the top of its category with a highlight badge. (Pricing coming soon.)</p><a class="btn" href="mailto:josemaria@mail.grokbot.com?subject=Featured%20listing">Contact us</a></div>
<div class="plan"><b>Site + newsletter sponsor</b><div class="price">TBD</div><p class="sub" style="font-size:14px">Logo in the header sponsor slot and in the weekly newsletter.</p><a class="btn" href="mailto:josemaria@mail.grokbot.com?subject=Sponsorship">Contact us</a></div></div></section>
<section id="newsletter" style="max-width:560px;margin:2.5rem auto;padding:1.25rem;border:1px solid #8884;border-radius:10px;text-align:center">
<h2 style="margin:0 0 .5rem">Get new agent use cases by email</h2>
<form id="nl-form" style="display:flex;gap:.5rem;justify-content:center;flex-wrap:wrap">
<input type="email" name="email" required placeholder="you@example.com" aria-label="Email" style="padding:.6rem;min-width:240px;border-radius:6px;border:1px solid #8888">
<button type="submit" style="padding:.6rem 1rem;border-radius:6px;cursor:pointer">Subscribe</button>
</form><p id="nl-msg" style="min-height:1.2em;margin:.5rem 0 0"></p></section>
<script>
const f=document.getElementById('nl-form'),m=document.getElementById('nl-msg');
f.addEventListener('submit',async e=>{e.preventDefault();m.textContent='Subscribing…';
try{const r=await fetch('/api/subscribe',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:String(new FormData(f).get('email')||'')})});const d=await r.json();
m.textContent=d.ok?'Thanks! You are subscribed.':(d.error||'Something went wrong.');if(d.ok)f.reset();}catch{m.textContent='Something went wrong.';}});
</script>
<div class="sponsor"><span>⭐ Your product here. Reach builders exploring AI agents.</span><a class="btn" href="mailto:josemaria@mail.grokbot.com?subject=Sponsor%20AI%20Agent%20Use%20Cases">Sponsor this site</a></div>
<footer>Every entry links to its original public source. Machine-readable list: <a href="/llms.txt">/llms.txt</a> · <a href="/llms-full.txt">/llms-full.txt</a> · <a href="/about/">About &amp; FAQ</a> · <a href="/sitemap-index.xml">Sitemap</a></footer>
</div>
<script>
import { track } from '@vercel/analytics';
const q=document.getElementById('q'),sel=document.getElementById('agent'),cards=[...document.querySelectorAll('.card')],chips=[...document.querySelectorAll('.chip')];let cat='',ag='',st;
function f(){const s=q.value.toLowerCase().trim();let n=0;cards.forEach(c=>{const ok=(!cat||c.dataset.cat===cat)&&(!ag||c.dataset.agents.split('|').includes(ag))&&(!s||c.dataset.text.includes(s));c.style.display=ok?'':'none';if(ok)n++});document.getElementById('count').textContent=n+' use cases';return n}
q.addEventListener('input',()=>{const n=f();clearTimeout(st);st=setTimeout(()=>{const v=q.value.trim();if(v.length>1)track('search_used',{query:v.slice(0,100),results:n})},800)});
chips.forEach(b=>b.onclick=()=>{cat=b.dataset.cat;chips.forEach(x=>x.classList.toggle('on',x===b));track('filter_used',{type:'category',value:cat||'all',results:f()})});
sel.onchange=()=>{ag=sel.value;track('filter_used',{type:'agent',value:ag||'all',results:f()})};
// Deep links: /?q=term, /?agent=Name, /?cat=Name (the WebSite SearchAction points at ?q=).
const up=new URLSearchParams(location.search);if(up.get('q'))q.value=up.get('q');if(up.get('agent')&&[...sel.options].some(o=>o.value===up.get('agent'))){ag=up.get('agent');sel.value=ag}if(up.get('cat')){const b=chips.find(x=>x.dataset.cat===up.get('cat'));if(b){cat=b.dataset.cat;chips.forEach(x=>x.classList.toggle('on',x===b))}}f();
document.querySelectorAll('a.src').forEach(a=>a.addEventListener('click',()=>track('source_click',{slug:a.dataset.slug,agent:a.dataset.agent})));
document.querySelectorAll('.vote').forEach(v=>v.querySelectorAll('button').forEach(b=>b.onclick=()=>{if(v.classList.contains('done'))return;v.classList.add('done');b.classList.add('on');track('usecase_feedback',{slug:v.dataset.slug,vote:b.dataset.v})}));
const nf=document.getElementById('nl-form');nf&&nf.addEventListener('submit',()=>track('newsletter_submit'));
</script></body></html>
