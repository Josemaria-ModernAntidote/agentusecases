---
import Base from '../layouts/Base.astro';
import { items, slugify, crumbs, abs, NAME, lastUpdated, clip, byAuthor, authorsFaq, authorLd, faqLd, sourceLabel } from '../lib/site';
// Every first-hand author credited by an entry (X handle, GitHub owner, Medium or Reddit user),
// each with an #anchor that is also their JSON-LD @id, and a Markdown twin at /authors.md.
const groups = byAuthor();
const credited = groups.reduce((n, g) => n + g.list.length, 0);
const path = '/authors/';
const title = `Who reported these AI agent use cases: ${groups.length} original authors | ${NAME}`;
const desc = clip(`The ${groups.length} people and accounts behind ${credited} real AI agent use cases: builders on X, GitHub, Reddit and Medium, each linked to their profile and to every entry they reported.`);
const qa = authorsFaq();
const ld = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Original authors of AI agent use cases', description: desc, url: abs(path), dateModified: lastUpdated, isPartOf: { '@type': 'WebSite', name: NAME, url: abs('/') },
    mainEntity: { '@type': 'ItemList', numberOfItems: groups.length, itemListElement: groups.map((g, i) => ({ '@type': 'ListItem', position: i + 1, item: { ...authorLd(g.a), subjectOf: g.list.map(d => ({ '@type': 'Article', name: d.title, url: abs(`/use-cases/${d.slug}/`) })) } })) } },
  faqLd(qa),
  crumbs([['Home', '/'], ['Authors', path]])
];
---
<Base title={title} desc={desc} path={path} ld={ld} md="/authors.md">
<p class="bc"><a href="/">Home</a> › Authors</p>
<h1>Who reported these AI agent use cases</h1>
<p class="lead">{credited} of the {items.length} entries come from a source that names its first-hand author: {groups.length} builders, parents, hobbyists and small operators on X, GitHub, Reddit and Medium. Each is listed with a link to their public profile and every use case they reported, most entries first. Last updated <time datetime={lastUpdated}>{lastUpdated}</time>.</p>
<h2>Quick answers</h2>
{qa.map(([q, a]) => <section><h3>{q}</h3><p>{a}</p></section>)}
<h2>All authors ({groups.length})</h2>
{groups.map(g => <section id={g.anchor}><h3><a href={g.a.url} rel="noopener nofollow">{g.a.name}{g.a.name !== g.a.handle ? ` (${g.a.handle})` : ''}</a> <span class="mut">{g.list.length} {g.list.length === 1 ? 'entry' : 'entries'} · {sourceLabel(g.list[0].source)}</span></h3><ul class="l">{g.list.map(d => <li><a href={`/use-cases/${d.slug}/`}>{d.title}</a> <span class="mut">({d.tools.map((t, i) => <>{i ? ', ' : ''}<a href={`/agents/${slugify(t)}/`}>{t}</a></>)}{d.added ? `, added ${d.added}` : ''})</span></li>)}</ul></section>)}
<p class="mut">Also as Markdown: <a href="/authors.md">/authors.md</a>. See also <a href="/sources/">entries by source type</a>.</p>
</Base>
