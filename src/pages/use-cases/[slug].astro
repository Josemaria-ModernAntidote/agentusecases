---
import Base from '../../layouts/Base.astro';
import { items, slugify, crumbs, abs, lastUpdated, NAME, clip, relatedTo, topicsFor, topicItems } from '../../lib/site';
export function getStaticPaths() { return items.map(d => ({ params: { slug: d.slug }, props: { d } })); }
const { d } = Astro.props;
const by = d.tools.join(', ');
const title = `${d.title} - ${by} use case | ${NAME}`;
const desc = clip(d.description);
const path = `/use-cases/${d.slug}/`;
const related = relatedTo(d);
const tps = topicsFor(d).filter(t => topicItems(t).length >= 3);
const modified = d.updated ?? d.added ?? lastUpdated;
const sameCat = items.filter(x => x.category === d.category);
const ci = sameCat.findIndex(x => x.slug === d.slug);
const prev = sameCat.length > 1 ? sameCat[(ci - 1 + sameCat.length) % sameCat.length] : null;
const next = sameCat.length > 2 ? sameCat[(ci + 1) % sameCat.length] : null;
const ld = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description, url: abs(path), ...(d.added ? { datePublished: d.added } : {}), dateModified: modified, mainEntityOfPage: { '@type': 'WebPage', '@id': abs(path) }, author: { '@type': 'Organization', name: NAME, url: abs('/') }, image: abs('/og.png'), articleSection: d.category, keywords: [...d.tools, d.category].join(', '), about: d.tools.map(t => ({ '@type': 'SoftwareApplication', name: t, applicationCategory: 'AI agent' })), isBasedOn: d.source, citation: d.source, publisher: { '@type': 'Organization', name: NAME, url: abs('/') } },
  crumbs([['Home', '/'], [d.category, `/categories/${slugify(d.category)}/`], [d.title, path]])
];
---
<Base title={title} desc={desc} path={path} ld={ld} type="article" md={`/use-cases/${d.slug}.md`}>
<p class="bc"><a href="/">Home</a> › <a href={`/categories/${slugify(d.category)}/`}>{d.category}</a> › {d.title}</p>
<article>
<h1>{d.title}</h1>
<p class="lead"><b>Summary:</b> {d.title} is a {d.category.toLowerCase()} use case for {by}. {d.description}</p>
<dl>
<dt class="mut">Agent(s)</dt><dd>{d.tools.map(t => <a class="tag" href={`/agents/${slugify(t)}/`}>{t}</a>)}</dd>
{d.niche && <><dt class="mut">Tag</dt><dd>Niche</dd></>}
{tps.length > 0 && <><dt class="mut">Topics</dt><dd>{tps.map(t => <a class="tag" href={`/topics/${t.slug}/`}>{t.name}</a>)}</dd></>}
<dt class="mut">Category</dt><dd><a href={`/categories/${slugify(d.category)}/`}>{d.category}</a></dd>
<dt class="mut">Original source</dt><dd><a href={d.source} rel="noopener">{d.sourceName} ↗</a></dd>
{d.added && <><dt class="mut">Added</dt><dd><time datetime={d.added}>{d.added}</time></dd></>}
<dt class="mut">Last updated</dt><dd><time datetime={modified}>{modified}</time></dd>
<dt class="mut">Plain text</dt><dd><a href={`/use-cases/${d.slug}.md`} type="text/markdown">Markdown version</a></dd>
</dl>
</article>
{related.length > 0 && <section><h2>Related use cases</h2><ul class="l">{related.map(r => <li><a href={`/use-cases/${r.slug}/`}>{r.title}</a> <span class="mut">({r.tools.join(', ')})</span></li>)}</ul></section>}
{prev && <nav class="mut" aria-label={`More ${d.category} use cases`}><p>More in <a href={`/categories/${slugify(d.category)}/`}>{d.category}</a>: <a href={`/use-cases/${prev.slug}/`} rel="prev">← {prev.title}</a>{next && <> · <a href={`/use-cases/${next.slug}/`} rel="next">{next.title} →</a></>}</p></nav>}
</Base>
