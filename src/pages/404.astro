---
import Base from '../layouts/Base.astro';
import { items, cats, agents, slugify, NAME } from '../lib/site';
const latest = items.filter(d => d.niche).slice(0, 8);
---
<Base title={`Page not found | ${NAME}`} desc="This page does not exist. Browse real, source-linked AI agent use cases by agent or category." path="/404/" noindex>
<h1>Page not found</h1>
<p class="lead">That page doesn't exist (or moved). Try the <a href="/">full searchable directory</a> of {items.length} AI agent use cases, or browse below.</p>
<h2>Categories</h2>
<p>{cats.map(c => <a class="tag" href={`/categories/${slugify(c)}/`}>{c}</a>)}</p>
<h2>Agents</h2>
<p>{agents.map(a => <a class="tag" href={`/agents/${slugify(a)}/`}>{a}</a>)}</p>
<h2>Niche picks</h2>
<ul class="l">{latest.map(d => <li><a href={`/use-cases/${d.slug}/`}>{d.title}</a> <span class="mut">({d.tools.join(', ')})</span></li>)}</ul>
</Base>
